# ==============================================================================
# VIETNAMESE BONDED WAREHOUSE AI (HỆ THỐNG AI XỬ LÝ CHỨNG TỪ KHO NGOẠI QUAN)
# Root Environment Configuration Template
# ==============================================================================

# --- Backend Configuration ---
APP_NAME="Vietnamese Bonded Warehouse AI"
APP_ENV="development"
DEBUG=true
API_V1_STR="/api/v1"

# --- Google Gemini API (BACKEND ONLY - NEVER EXPOSE TO FRONTEND) ---
# Acquire your API key at: https://aistudio.google.com/
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
GEMINI_MODEL="gemini-3.8-flash"

# --- Database (SQLite with WAL Mode for Windows 10 Localhost) ---
DATABASE_URL="sqlite:///./bonded_warehouse.db"

# --- Storage Settings ---
UPLOAD_DIR="../data/uploads"
MAX_UPLOAD_SIZE_MB=25

# --- Security & CORS ---
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# --- Frontend Configuration ---
VITE_API_BASE_URL="http://127.0.0.1:8000/api/v1"
