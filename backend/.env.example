# Vietnamese Bonded Warehouse AI - Backend Environment Configuration

# Application
APP_NAME="Vietnamese Bonded Warehouse AI"
APP_ENV="development"
DEBUG=true
API_V1_STR="/api/v1"

# Google Gemini API
# Acquire key at https://aistudio.google.com/
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
GEMINI_MODEL="gemini-2.5-flash"

# Database (SQLite with WAL mode for Windows compatibility)
DATABASE_URL="sqlite:///./bonded_warehouse.db"

# Storage
UPLOAD_DIR="./storage/uploads"
MAX_UPLOAD_SIZE_MB=25

# CORS (Frontend URL)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
